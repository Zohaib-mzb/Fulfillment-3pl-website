---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Art from '@/components/illustrations/Art.astro';
import HeroFilm from '@/components/hero/HeroFilm.astro';
import { heroPoster } from '@/lib/hero-poster';
import ScrollStory from '@/components/story/ScrollStory.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import FAQ from '@/components/ui/FAQ.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import RouteDivider from '@/components/ui/RouteDivider.astro';
import Proof from '@/components/ui/Proof.astro';
import Decor from '@/components/ui/Decor.astro';
import ComingSoon from '@/components/ui/ComingSoon.astro';
import { SITE } from '@/config/site';
import { SERVICES } from '@/data/services';
import { INDUSTRIES } from '@/data/industries';
import { CITIES } from '@/data/cities';
import { HOME_FAQS } from '@/data/faqs';
import { faqPage, service } from '@/lib/schema';

const serviceIcons = { 'same-day-delivery': 'clock', 'final-mile-delivery': 'van', 'rush-scheduled-delivery': 'route', 'b2b-retail-delivery': 'store', fulfillment: 'rack', returns: 'return' } as const;

const why = [
  { icon: 'clock', title: 'Same day across the GTA', text: 'Order by late morning, delivered the same day to Toronto, Mississauga, Brampton, Vaughan and Markham, with next day as standard.' },
  { icon: 'check', title: 'No minimum volume', text: 'We work with growing brands. Start with the orders you have today and get big carrier service as you grow.' },
  { icon: 'layers', title: 'One partner for storage, packing and delivery', text: 'Warehousing, pick and pack, delivery and returns run by one team, so there is one place to ask.' },
  { icon: 'plug', title: 'EV first fleet', text: 'Electric vans go on routes first. Dense city routes are exactly where they work best.' },
  { icon: 'camera', title: 'Photo proof on every delivery', text: 'Live SMS and email tracking, a photo of every parcel at the door and a signature on request.' },
  { icon: 'person', title: 'Real humans on support', text: 'A named account contact who knows your orders and replies fast, not a ticket queue.' },
] as const;

const poster = await heroPoster();

const integrations = [
  { name: 'Shopify', note: 'Primary integration', soon: false },
  { name: 'WooCommerce', note: 'Store connection', soon: false },
  { name: 'BigCommerce', note: 'Store connection', soon: false },
  { name: 'CSV and labels', note: 'Our labels and a daily manifest', soon: false },
  { name: 'API and Shopify app', note: 'For custom setups and one click install', soon: true },
];
---
<BaseLayout
  title="3PL and Same Day Delivery in Toronto & GTA | Kinematics"
  description="3PL, fulfillment and same day final mile delivery across Toronto and the GTA. Storage, pick and pack, same day and next day delivery, no minimums."
  schema={[
    faqPage(HOME_FAQS, '/'),
    ...SERVICES.map((s) => service({ name: s.name, description: s.answer, url: s.href, serviceType: s.serviceType })),
  ]}
>
  <link slot="head" rel="preload" as="image" type="image/avif" imagesrcset={poster.avifSet} imagesizes={poster.sizes} fetchpriority="high" />
  <HeroFilm />

  <ScrollStory />

  <RouteDivider />

  <!-- SERVICES -->
  <section class="relative overflow-hidden bg-white pb-20" aria-labelledby="services-title">
    <Decor preset="section" />
    <div class="container-site relative z-10">
      <SectionHeading id="services-title" eyebrow="Services" title="What can Kinematics do for your brand?" text="Same day delivery leads, with next day, rush, B2B, warehousing and returns alongside. Use one service or all of them; they are built to work together." />
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {SERVICES.map((s) => (
          <li class="card group relative flex flex-col card-motion">
            <span class="grid size-12 place-items-center rounded-2xl bg-teal-50 text-teal-ink"><Icon name={serviceIcons[s.slug as keyof typeof serviceIcons]} /></span>
            <h3 class="mt-5 text-xl"><a href={s.href} class="no-underline after:absolute after:inset-0 after:rounded-card">{s.name}</a></h3>
            <p class="mt-2 flex-1 text-slate">{s.short}</p>
            <span class="mt-5 inline-flex items-center gap-1.5 font-semibold text-navy" aria-hidden="true">Learn more <Icon name="arrow" size={18} class="transition-transform group-hover:translate-x-1" /></span>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-slate">Every service includes our shipping labels and daily manifest, <a href="/integrations" class="link">Shopify and CSV integrations</a> (API coming soon), live SMS and email tracking, photo proof with signature on request, our <a href="/ev-delivery" class="link">EV first delivery fleet</a> and a named account contact. No minimum volume.</p>
      <div class="mt-6 text-slate">
        <h3 class="text-xl text-navy">Our fleet</h3>
        <p class="mt-2"><strong class="text-navy">EVs</strong> are our primary vehicles and run most urban routes. <strong class="text-navy">Cargo vans</strong> carry larger loads, and <strong class="text-navy">box trucks</strong> handle bulk and heavy freight.</p>
      </div>
    </div>
  </section>

  <!-- WHY -->
  <section class="on-dark relative overflow-hidden bg-navy py-20 text-white sm:py-24" aria-labelledby="why-title">
    <Decor preset="dark" />
    <div class="container-site relative z-10">
      <div class="max-w-3xl">
        <p class="eyebrow mb-3">Why Kinematics</p>
        <h2 id="why-title" class="text-3xl text-white sm:text-[2.6rem]">Why do growing brands choose Kinematics?</h2>
        <p class="lede mt-4">Because they get same day delivery, one partner from shelf to doorstep and people who answer, with no minimum volume.</p>
      </div>
      <ul class="mt-12 grid gap-px overflow-hidden rounded-card bg-white/10 sm:grid-cols-2 lg:grid-cols-3">
        {why.map((w, i) => (
          <li class="bg-navy p-6 sm:p-7 icon-hover">
            <span class:list={['grid size-11 place-items-center rounded-xl', i === 3 ? 'bg-orange text-navy' : 'bg-white/10 text-teal']}><Icon name={w.icon} /></span>
            <h3 class="mt-5 text-lg text-white">{w.title}</h3>
            <p class="mt-2 text-[0.97rem] text-[#C9D2DC]">{w.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- INTEGRATIONS -->
  <section class="bg-cloud py-16" aria-labelledby="integrations-title">
    <div class="container-site grid items-center gap-8 lg:grid-cols-[1fr_2fr]">
      <div>
        <h2 id="integrations-title" class="text-2xl sm:text-3xl">Does it work with my store?</h2>
        <p class="mt-3 text-slate">Orders flow in automatically and stock levels sync back. <a href="/integrations" class="link">See integrations</a>.</p>
      </div>
      <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
        {integrations.map((i) => (
          <li class="flex min-h-24 flex-col justify-center rounded-2xl border border-slate-line bg-white px-4 py-4 card-motion">
            <span class="font-heading text-lg font-semibold leading-tight">{i.name}</span>
            <span class="mt-1 text-sm text-slate">{i.note}</span>
            {i.soon && <ComingSoon class="mt-2 self-start" />}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- INDUSTRIES -->
  <section class="bg-white py-20 sm:py-24" aria-labelledby="industries-title">
    <div class="container-site">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeading id="industries-title" eyebrow="Industries" title="Who do we work with?" text="Direct to consumer and wholesale brands whose products need care, speed and accuracy." />
        <a href="/industries" class="link">All industries</a>
      </div>
      <ul class="mt-12 grid gap-5 md:grid-cols-2">
        {INDUSTRIES.map((ind) => (
          <li class="group relative grid grid-cols-[96px_1fr] items-center gap-5 rounded-card border border-slate-line p-5 transition-colors hover:border-teal sm:grid-cols-[140px_1fr] card-motion">
            <Art scene={ind.art} decorative class="rounded-2xl" />
            <div>
              <h3 class="text-xl"><a href={`/industries/${ind.slug}`} class="no-underline after:absolute after:inset-0 after:rounded-card">{ind.name}</a></h3>
              <p class="mt-1.5 text-slate">{ind.short}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- SERVICE AREA -->
  <section class="relative overflow-hidden bg-cloud py-20 sm:py-24" aria-labelledby="areas-title">
    <Decor preset="band" />
    <div class="relative z-10 container-site grid items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow mb-3">Service area</p>
        <h2 id="areas-title" class="text-3xl sm:text-[2.6rem]">Where does Kinematics deliver?</h2>
        <p class="lede mt-4">Our own EV first fleet covers five GTA cities, with same day delivery for orders placed by late morning and next day as standard.</p>
        <ul class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3">
          {CITIES.map((c) => (
            <li><a href={`/service-areas/${c.slug}`} class="flex items-center gap-2 rounded-xl border border-slate-line bg-white px-4 py-3 font-semibold text-navy no-underline hover:border-teal"><Icon name="pin" size={18} class="text-teal-ink" />{c.name}</a></li>
          ))}
        </ul>
        <a href="/service-areas" class="link mt-6 inline-block">All service areas</a>
      </div>
      <Art scene="map" alt="Stylized map of the GTA showing Brampton, Vaughan, Markham, Mississauga and Toronto along Lake Ontario." />
    </div>
  </section>

  <Proof />

  <!-- FAQ TEASER -->
  <section class="bg-white py-20 sm:py-24">
    <div class="container-site grid gap-12 lg:grid-cols-[1fr_1.6fr]">
      <div>
        <p class="eyebrow mb-3">FAQ</p>
        <p class="font-heading text-3xl font-bold sm:text-4xl">Quick answers</p>
        <p class="mt-4 text-slate">More in the <a href="/faq" class="link">full FAQ</a>, or <a href="/contact" class="link">ask a person</a>.</p>
      </div>
      <FAQ items={HOME_FAQS} title="Common questions about Kinematics" id="home-faq" />
    </div>
  </section>

  <CtaBand />
</BaseLayout>
