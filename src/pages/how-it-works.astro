---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Icon from '@/components/ui/Icon.astro';
import FAQ from '@/components/ui/FAQ.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import Related from '@/components/ui/Related.astro';
import Art from '@/components/illustrations/Art.astro';
import { abs, faqPage } from '@/lib/schema';

const crumbs = [{ name: 'Home', href: '/' }, { name: 'How it works', href: '/how-it-works' }];

const steps = [
  {
    icon: 'link', title: 'Connect your store',
    text: 'We connect Shopify, WooCommerce or BigCommerce, or set up CSV or API ordering, so new orders reach us automatically and stock levels sync back to your store.',
    link: { href: '/integrations', label: 'See integrations' },
  },
  {
    icon: 'box', title: 'Send us your stock',
    text: 'Tell us what is coming, then ship it in. We count it against your notice, flag anything that doesn’t match and give every SKU its own bin location.',
    link: { href: '/services/fulfillment', label: 'How receiving works' },
  },
  {
    icon: 'layers', title: 'We pick and pack',
    text: 'Each order is scan picked, packed to fit with your inserts and labelled. Orders in before the daily cutoff are packed the same day.',
    link: { href: '/services/fulfillment', label: 'Pick and pack' },
  },
  {
    icon: 'van', title: 'We deliver',
    text: 'Our EV first fleet delivers across the GTA next day, or same day for orders placed by late morning. Customers get a live tracking link and photo proof.',
    link: { href: '/services/final-mile-delivery', label: 'Final mile delivery' },
  },
  {
    icon: 'chart', title: 'You see everything',
    text: 'Stock levels, order status, delivery photos and returns in one place, and a real person to talk to when you need context.',
    link: { href: '/services/returns', label: 'Returns and reporting' },
  },
] as const;

const faqs = [
  { q: 'How long does it take to get started?', a: 'It depends on how many SKUs you have and how your stock reaches us. After a first call, we send an onboarding plan with dates so you know exactly when orders will start flowing.' },
  { q: 'Do I have to use every step?', a: 'No. You can use fulfillment on its own, delivery on its own, or both together. They are designed to work best together.' },
  { q: 'What do I need to send you to begin?', a: 'A list of your SKUs, your packaging and inserts, and a shipment notice for your first inbound. We guide you through it during onboarding.' },
];

const howTo = {
  '@type': 'HowTo',
  name: 'How Kinematics fulfils and delivers your orders',
  description: 'Five steps from connecting your store to seeing every order delivered.',
  step: steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.title, text: s.text, url: abs(`/how-it-works#step-${i + 1}`) })),
};
---
<BaseLayout
  title="How 3PL Fulfillment Works in 5 Steps | Kinematics"
  description="Connect your store, send stock, we pack, we deliver across the GTA, and you see everything. Here is how Kinematics fulfillment and delivery works."
  crumbs={crumbs}
  schema={[howTo, faqPage(faqs, '/how-it-works')]}
>
  <PageHero
    eyebrow="How it works"
    title="How does 3PL fulfillment work with Kinematics?"
    answer="Kinematics works in five steps: you connect your online store, send us your inventory, and we pick, pack and deliver each order across the GTA with our EV first fleet. You see stock, orders, delivery photos and returns as they happen, and talk to real people when you need help."
    crumbs={crumbs}
  >
    <Art slot="art" scene="hero" alt="Illustration of a parcel's route from box to van to a customer's house." />
  </PageHero>

  <section class="container-site py-16 sm:py-24" aria-labelledby="steps-title">
    <h2 id="steps-title" class="sr-only">The five steps</h2>
    <ol class="relative grid gap-12">
      <span class="route-line absolute bottom-8 left-[1.6rem] top-8 w-3 -translate-x-1/2" aria-hidden="true"></span>
      {steps.map((s, i) => (
        <li id={`step-${i + 1}`} class="relative grid grid-cols-[3.2rem_1fr] gap-6">
          <span class:list={['relative z-10 grid size-[3.2rem] place-items-center rounded-full', i === steps.length - 1 ? 'bg-orange text-navy' : 'bg-navy text-white']}>
            <Icon name={s.icon} />
          </span>
          <div class="max-w-2xl pt-1">
            <p class="font-heading text-sm font-semibold uppercase tracking-[0.14em] text-teal-ink">Step {i + 1}</p>
            <h3 class="mt-1 text-2xl sm:text-3xl">{s.title}</h3>
            <p class="mt-3 text-lg text-navy/85">{s.text}</p>
            <a href={s.link.href} class="link mt-3 inline-block">{s.link.label}</a>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="bg-cloud py-16 sm:py-20">
    <div class="container-site"><FAQ items={faqs} title="Getting started: common questions" /></div>
  </section>

  <Related title="Go deeper" services={['fulfillment', 'final-mile-delivery', 'same-day-delivery', 'returns']} posts={['how-to-choose-a-3pl-in-toronto', 'shopify-fulfillment-in-canada']} />
  <CtaBand />
</BaseLayout>
