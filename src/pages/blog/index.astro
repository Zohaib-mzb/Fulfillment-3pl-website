---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import PostCard from '@/components/ui/PostCard.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import { getPosts } from '@/lib/blog';
import { BLOG_CATEGORIES } from '@/content.config';
import { abs } from '@/lib/schema';

const posts = await getPosts();
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Blog', href: '/blog' }];
const usedCats = Object.entries(BLOG_CATEGORIES).filter(([k]) => posts.some((p) => p.data.category === k));
const itemList = {
  '@type': 'ItemList',
  itemListElement: posts.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(`/blog/${p.id}`), name: p.data.title })),
};
---
<BaseLayout
  title="Blog: Fulfillment, Delivery & Shopify Guides | Kinematics"
  description="Practical guides for growing brands on 3PL fulfillment, next day and same day delivery in the GTA, Shopify setup, returns and EV delivery."
  crumbs={crumbs}
  schema={[itemList]}
>
  <PageHero eyebrow="Blog" title="Guides for brands that ship" lede="Plain English guides on fulfillment, GTA delivery, Shopify, returns and EV delivery, written by the Kinematics team." crumbs={crumbs} primaryCta={false} />
  <section class="container-site py-14 sm:py-16">
    <nav aria-label="Blog categories">
      <ul class="flex flex-wrap gap-2">
        <li><a href="/blog" aria-current="page" class="inline-flex rounded-full bg-navy px-4 py-2 text-sm font-semibold text-white no-underline">All posts</a></li>
        {usedCats.map(([k, v]) => <li><a href={`/blog/category/${k}`} class="inline-flex rounded-full border border-slate-line px-4 py-2 text-sm font-semibold text-navy no-underline hover:border-teal">{v}</a></li>)}
      </ul>
    </nav>
    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((p, i) => <li class="flex"><PostCard post={p} eager={i < 3} /></li>)}
    </ul>
    <p class="mt-10 text-slate">Subscribe with <a href="/rss.xml" class="link">RSS</a>.</p>
  </section>
  <CtaBand />
</BaseLayout>
