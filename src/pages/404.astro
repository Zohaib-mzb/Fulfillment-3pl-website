---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { house, parcel, route, C, VIEWBOX } from '@/components/illustrations/art';
const art = [
  `<rect width="480" height="360" rx="28" fill="${C.teal50}"/>`,
  house(250, 70, 1),
  route('M20 300 C 120 300, 170 270, 240 250', { width: 5, gap: 13 }),
  // the route overshoots the door and wanders off…
  route('M240 250 C 300 232, 380 300, 440 316', { width: 4, gap: 12, color: C.edge }),
  parcel(400, 270, 46, 36, { rotate: 18, label: true }),
  `<circle cx="330" cy="246" r="9" fill="none" stroke="${C.orange}" stroke-width="3" stroke-dasharray="4 4"/>`,
  `<text x="330" y="276" text-anchor="middle" font-family="Inter, Arial, sans-serif" font-size="12" font-weight="600" fill="${C.slate}">door was here</text>`,
].join('');
---
<BaseLayout title="Page Not Found (404) | Kinematics" description="This parcel missed the door. The page you were looking for has moved or does not exist." noindex>
  <section class="container-site grid items-center gap-10 py-16 sm:py-24 lg:grid-cols-2">
    <div>
      <p class="eyebrow mb-4">Error 404</p>
      <h1 class="text-[2.6rem] sm:text-6xl">This parcel missed the door.</h1>
      <p class="lede mt-5 max-w-lg">The page you were looking for has moved, or the address was a little off. Let’s get you back on route.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="btn btn-primary">Back to home</a>
        <a href="/contact" class="btn btn-secondary">Contact us</a>
      </div>
      <nav aria-label="Popular pages" class="mt-10">
        <p class="font-semibold">Popular pages</p>
        <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
          <li><a href="/services/same-day-delivery" class="link">Same day delivery</a></li>
          <li><a href="/services/fulfillment" class="link">Warehousing and fulfillment</a></li>
          <li><a href="/track" class="link">Track a parcel</a></li>
          <li><a href="/blog" class="link">Blog</a></li>
          <li><a href="/get-a-quote" class="link">Get a quote</a></li>
        </ul>
      </nav>
    </div>
    <svg viewBox={VIEWBOX} class="h-auto w-full" role="img" aria-label="Illustration: a dotted delivery route overshoots a house's front door and a parcel lands askew on the lawn." set:html={art} />
  </section>
</BaseLayout>
