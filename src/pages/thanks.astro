---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
---
<BaseLayout title="Thanks | Kinematics" description="Thanks for getting in touch with Kinematics." noindex>
  <section class="container-site grid min-h-[60vh] place-items-center py-20 text-center">
    <div class="max-w-xl">
      <svg viewBox="0 0 220 60" class="mx-auto w-56" aria-hidden="true"><rect x="2" y="20" width="34" height="28" rx="4" fill="#F4F6F8" stroke="#C5CDD6" /><rect x="15" y="20" width="8" height="28" fill="#12B5A6" /><path d="M44 34 H190" stroke="#12B5A6" stroke-width="5" stroke-linecap="round" stroke-dasharray="0 12" /><circle cx="204" cy="34" r="10" fill="#FF6A3D" /></svg>
      <h1 class="mt-8 text-4xl sm:text-5xl" data-thanks-title>Thanks, it’s in.</h1>
      <p class="lede mt-4" data-thanks-text>A real person on our team will reply within one business day.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn btn-primary">Back to home</a>
        <a href="/blog" class="btn btn-secondary">Read the blog</a>
      </div>
    </div>
  </section>
  <script define:vars={{ email: SITE.email }}>
    const p = new URLSearchParams(location.search);
    const err = p.get('error');
    if (err) {
      document.querySelector('[data-thanks-title]').textContent = err === 'rate_limited' ? 'Please try again shortly' : 'Something went wrong';
      document.querySelector('[data-thanks-text]').textContent = err === 'invalid'
        ? 'Some required details were missing. Please go back and check the form.'
        : 'Your form could not be sent. Please email ' + email + ' and we will help.';
    } else if (p.get('form') === 'quote') {
      document.querySelector('[data-thanks-text]').textContent = 'We will reply with a plan and custom quote, usually within one business day.';
    }
  </script>
</BaseLayout>
