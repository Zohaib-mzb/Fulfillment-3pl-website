---
import '@/styles/fonts.css';
import '@/styles/global.css';
import headingFont from '@/assets/fonts/space-grotesk-latin-700-normal-core.woff2?url';
import bodyFont from '@/assets/fonts/inter-latin-400-normal-core.woff2?url';

import SEO, { type SeoProps } from '@/components/seo/SEO.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import CookieBanner from '@/components/layout/CookieBanner.astro';
import Analytics from '@/components/layout/Analytics.astro';
import { ClientRouter } from 'astro:transitions';
import { TOOL_INFO, QUOTE_FIELDS, services, serviceAreas, contact } from '@/lib/agent-tools';

/** WebMCP tools registered in the page (only where navigator.modelContext exists). Kept under 2 KB. */
const webmcp = JSON.stringify({
  d: TOOL_INFO.map((t) => t.description),
  s: services().map(({ name, url }) => [name, new URL(url).pathname]),
  a: serviceAreas().map(({ name }) => name),
  c: (({ email, phone, hours }) => ({ email, phone, hours: hours.join('; ') + ' (Toronto time)', page: '/contact' }))(contact()),
  q: QUOTE_FIELDS,
}).replace(/</g, '\\u003c');
const webmcpJs = `addEventListener('load',()=>{if(!('modelContext' in navigator))return;try{const D=${webmcp},O=location.origin,T=(v)=>({content:[{type:'text',text:JSON.stringify(v)}]}),S=(p)=>({type:'object',properties:p}),str={type:'string'},m=navigator.modelContext;let n=0;const r=(name,f,inputSchema=S({}))=>{try{m.registerTool({name,description:D.d[n++],inputSchema,execute:async(i)=>T(f(i||{}))})}catch(e){}};const L2=(x)=>x.map(([name,p])=>({name,url:O+p}));r('get_services',()=>L2(D.s));r('get_service_areas',()=>D.a.map((name)=>({name,url:O+'/service-areas/'+name.toLowerCase()})));r('get_contact',()=>({...D.c,page:O+D.c.page}));r('start_quote',(i)=>{const u=new URL('/get-a-quote',O);for(const k of D.q)if(i[k])u.searchParams.set(k,String(i[k]).trim());return{url:u.href}},S(Object.fromEntries(D.q.map((k)=>[k,str]))));r('track_parcel',(i)=>{const t=String(i.tracking_number||'').trim();return/^[A-Za-z0-9-]{6,40}$/.test(t)?{url:O+'/track?tracking='+encodeURIComponent(t)}:{error:'Invalid tracking number'}},{...S({tracking_number:str}),required:['tracking_number']})}catch(e){}})`;

/** Content slides + fades between pages; the header (named, animate none) stays put. */
const ease = 'cubic-bezier(0.22, 1, 0.36, 1)';
const pageAnim = {
  forwards: {
    old: { name: 'kin-page-out', duration: '0.22s', easing: 'ease-in', fillMode: 'both' },
    new: { name: 'kin-page-in', duration: '0.45s', easing: ease, fillMode: 'both' },
  },
  backwards: {
    old: { name: 'kin-page-out-back', duration: '0.22s', easing: 'ease-in', fillMode: 'both' },
    new: { name: 'kin-page-in-back', duration: '0.45s', easing: ease, fillMode: 'both' },
  },
};

type Props = SeoProps & { bodyClass?: string; preloadImage?: string };
const { bodyClass = '', preloadImage, ...seo } = Astro.props;
---
<!doctype html>
<html lang="en-CA" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <script is:inline set:html={webmcpJs} />
    <ClientRouter fallback="animate" />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <SEO {...seo} />
    <meta name="theme-color" content="#0E1B2C" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Kinematics blog" href="/rss.xml" />
    <link rel="author" href="/llms.txt" type="text/plain" />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a href="#main" class="sr-only-focusable fixed left-4 top-3 z-[100] rounded-full bg-orange px-5 py-3 font-semibold text-navy">Skip to main content</a>
    <div class="nav-progress" aria-hidden="true" transition:persist="nav-progress"></div>
    <Header />
    <main id="main" tabindex="-1" class="outline-none" transition:name="page" transition:animate={pageAnim}>
      <slot />
    </main>
    <Footer />
    <CookieBanner />
    <Analytics />
    <script>
      import '@/scripts/motion';
    </script>
  </body>
</html>
