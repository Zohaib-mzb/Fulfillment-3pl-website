---
/** Text, email, tel, url, number and file inputs, with label, hint and error slots. */
interface Props {
  name: string; label: string; type?: 'text' | 'email' | 'tel' | 'url' | 'number' | 'file'; required?: boolean; hint?: string; autocomplete?: string;
  placeholder?: string; value?: string; accept?: string; inputmode?: string; maxlength?: number; class?: string; min?: number;
  /** WebMCP: describes this field as a tool parameter for in-browser agents (toolparamdescription). */
  toolparam?: string;
}
const { name, label, type = 'text', required = false, hint, autocomplete, placeholder, value, accept, inputmode, maxlength, class: cls = '', min, toolparam } = Astro.props;
const id = `f-${name}`;
const describedBy = [hint && `${id}-hint`, `${id}-error`].filter(Boolean).join(' ');
---
<div class={cls}>
  <label for={id} class="field-label">{label}{required ? <span aria-hidden="true" class="text-[#B3261E]"> *</span> : <span class="font-normal text-slate"> (optional)</span>}</label>
  <input
    id={id} name={name} type={type} required={required} autocomplete={autocomplete} placeholder={placeholder} value={value}
    accept={accept} inputmode={inputmode as any} maxlength={maxlength} min={min} aria-describedby={describedBy} toolparamdescription={toolparam}
    class:list={['field', type === 'file' && 'file:mr-4 file:rounded-full file:border-0 file:bg-navy file:px-4 file:py-2 file:font-semibold file:text-white']}
  />
  {hint && <p id={`${id}-hint`} class="field-hint">{hint}</p>}
  <p id={`${id}-error`} class="field-error" data-error-for={name}></p>
</div>
