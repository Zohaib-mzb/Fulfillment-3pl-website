---
interface Props { name: string; label: string; options: readonly string[]; required?: boolean; hint?: string; selected?: string }
const { name, label, options, required = false, hint, selected } = Astro.props;
const id = `f-${name}`;
---
<div>
  <label for={id} class="field-label">{label}{required ? <span aria-hidden="true" class="text-[#B3261E]"> *</span> : <span class="font-normal text-slate"> (optional)</span>}</label>
  <select id={id} name={name} required={required} class="field field-select" aria-describedby={[hint && `${id}-hint`, `${id}-error`].filter(Boolean).join(' ')}>
    <option value="">Choose one…</option>
    {options.map((o) => <option value={o} selected={o === selected}>{o}</option>)}
  </select>
  {hint && <p id={`${id}-hint`} class="field-hint">{hint}</p>}
  <p id={`${id}-error`} class="field-error" data-error-for={name}></p>
</div>
