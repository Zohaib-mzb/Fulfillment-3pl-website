---
interface Props { name: string; label: string; required?: boolean; hint?: string; rows?: number; maxlength?: number; placeholder?: string; /** WebMCP toolparamdescription */ toolparam?: string }
const { name, label, required = false, hint, rows = 5, maxlength = 4000, placeholder, toolparam } = Astro.props;
const id = `f-${name}`;
---
<div>
  <label for={id} class="field-label">{label}{required ? <span aria-hidden="true" class="text-[#B3261E]"> *</span> : <span class="font-normal text-slate"> (optional)</span>}</label>
  <textarea id={id} name={name} rows={rows} required={required} maxlength={maxlength} placeholder={placeholder} toolparamdescription={toolparam} class="field" aria-describedby={[hint && `${id}-hint`, `${id}-error`].filter(Boolean).join(' ')}></textarea>
  {hint && <p id={`${id}-hint`} class="field-hint">{hint}</p>}
  <p id={`${id}-error`} class="field-error" data-error-for={name}></p>
</div>
