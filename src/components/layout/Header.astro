---
import Logo from '@/components/Logo.astro';
import { HEADER_NAV, SITE, phoneHref, type NavGroup, type NavItem } from '@/config/site';

const current = Astro.url.pathname.replace(/\.html$/, '');
const isGroup = (n: NavGroup | NavItem): n is NavGroup => 'items' in n;
const active = (href: string) => (href === '/' ? current === '/' : current === href || current.startsWith(href + '/'));
const groupActive = (g: NavGroup) => g.items.some((i) => active(i.href));
const tel = phoneHref();
---
<header transition:name="site-header" transition:animate="none" class="sticky top-0 z-50 border-b border-slate-line/70 bg-white/92 backdrop-blur supports-[backdrop-filter]:bg-white/80" data-header>
  <div class="container-site flex h-[var(--header-h)] items-center justify-between gap-4">
    <a href="/" class="-m-1 rounded-lg p-1 no-underline" aria-label="Kinematics home">
      <Logo size={34} />
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1 text-[0.95rem] font-medium">
        {HEADER_NAV.map((n, i) =>
          isGroup(n) ? (
            <li class="nav-group relative" data-nav-group>
              <button
                type="button"
                class:list={['flex items-center gap-1 rounded-full px-3 py-2 hover:bg-cloud', groupActive(n) && 'text-teal-ink']}
                aria-expanded="false"
                aria-controls={`nav-panel-${i}`}
              >
                {n.label}
                <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" class="nav-caret transition-transform"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </button>
              <div id={`nav-panel-${i}`} class="nav-panel absolute left-0 top-full z-10 w-72 pt-2">
                <ul class="rounded-2xl border border-slate-line bg-white p-2 shadow-card">
                  {n.items.map((item, idx) => (
                    <li style={`--i:${idx}`}>
                      <a
                        href={item.href}
                        class="block rounded-xl px-3 py-2.5 no-underline hover:bg-cloud"
                        aria-current={active(item.href) ? 'page' : undefined}
                      >
                        <span class="block font-semibold text-navy">{item.label}</span>
                        {item.description && <span class="block text-sm text-slate">{item.description}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ) : (
            <li>
              <a
                href={n.href}
                class:list={['block rounded-full px-3 py-2 no-underline hover:bg-cloud', active(n.href) ? 'text-teal-ink' : 'text-navy']}
                aria-current={active(n.href) ? 'page' : undefined}
              >{n.label}</a>
            </li>
          )
        )}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="/track" class="hidden rounded-full px-3 py-2 text-[0.95rem] font-semibold text-navy underline decoration-teal decoration-2 underline-offset-4 hover:decoration-navy sm:inline-flex">Track a parcel</a>
      <a href="/get-a-quote" class="btn btn-primary hidden min-h-11 px-5 py-2 sm:inline-flex">Get a quote</a>

      <!-- Mobile menu: <details> works without JavaScript. -->
      <details class="mobile-nav lg:hidden" data-mobile-nav>
        <summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-full border border-slate-line [&::-webkit-details-marker]:hidden" aria-label="Menu">
          <svg class="icon-open" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          <svg class="icon-close" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        </summary>
        <!-- Height from the viewport: the header's backdrop blur makes it the containing block for this fixed panel, so bottom-0 would collapse it. -->
        <div class="fixed inset-x-0 top-[var(--header-h)] h-[calc(100dvh-var(--header-h))] overflow-y-auto border-t border-slate-line bg-white">
          <nav aria-label="Main (mobile)" class="container-site py-6">
            <ul class="space-y-6">
              {HEADER_NAV.map((n) =>
                isGroup(n) ? (
                  <li>
                    <p class="eyebrow mb-2">{n.label}</p>
                    <ul class="grid gap-1">
                      {n.items.map((item) => (
                        <li><a href={item.href} class="block rounded-lg py-2 text-lg font-medium text-navy no-underline" aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a></li>
                      ))}
                    </ul>
                  </li>
                ) : (
                  <li><a href={n.href} class="block py-1 font-heading text-xl font-semibold text-navy no-underline" aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a></li>
                )
              )}
            </ul>
            <div class="mt-8 grid gap-3 border-t border-slate-line pt-6">
              <a href="/get-a-quote" class="btn btn-primary w-full">Get a quote</a>
              <a href="/track" class="btn btn-secondary w-full">Track a parcel</a>
              {tel && <a href={tel} class="block py-2 text-center text-lg font-semibold text-navy underline decoration-teal decoration-2 underline-offset-4">Call {SITE.phone}</a>}
            </div>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  /* visibility flips instantly on open (so Tab can enter at once) and only after the fade on close. */
  .nav-panel { visibility: hidden; opacity: 0; transform: translateY(-4px); transition: opacity .15s, transform .15s, visibility 0s linear .15s; }
  .nav-group[data-open] .nav-panel { visibility: visible; opacity: 1; transform: none; transition-delay: 0s; }
  .nav-group[data-open] .nav-caret { transform: rotate(180deg); }
  /* No-JS fallback: open on hover/focus. */
  :global(html:not(.js)) .nav-group:hover .nav-panel,
  :global(html:not(.js)) .nav-group:focus-within .nav-panel { visibility: visible; opacity: 1; transform: none; }
  .mobile-nav .icon-close { display: none; }
  .mobile-nav[open] .icon-close { display: block; }
  .mobile-nav[open] .icon-open { display: none; }
</style>

<script>
  import { onPage } from '@/scripts/lifecycle';
  onPage(() => {
    const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-group]'));
    const mobile = document.querySelector<HTMLDetailsElement>('[data-mobile-nav]');
    const close = (except?: HTMLElement) =>
      groups.forEach((g) => {
        if (g === except) return;
        g.removeAttribute('data-open');
        g.querySelector('button')?.setAttribute('aria-expanded', 'false');
      });
    groups.forEach((g) => {
      const btn = g.querySelector('button')!;
      btn.addEventListener('click', () => {
        const open = !g.hasAttribute('data-open');
        close(g);
        g.toggleAttribute('data-open', open);
        btn.setAttribute('aria-expanded', String(open));
      });
      g.addEventListener('focusout', (e) => {
        if (!g.contains((e as FocusEvent).relatedTarget as Node)) close();
      });
    });
    const onDocClick = (e: MouseEvent) => { if (!groups.some((g) => g.contains(e.target as Node))) close(); };
    const onKey = (e: KeyboardEvent) => {
      if (e.key !== 'Escape') return;
      const openGroup = groups.find((g) => g.hasAttribute('data-open'));
      if (openGroup) { close(); openGroup.querySelector('button')?.focus(); }
      if (mobile?.open) { mobile.open = false; mobile.querySelector('summary')?.focus(); }
    };
    // Lock page scroll while the mobile menu is open.
    const onToggle = () => { document.documentElement.style.overflow = mobile?.open ? 'hidden' : ''; };
    document.addEventListener('click', onDocClick);
    document.addEventListener('keydown', onKey);
    mobile?.addEventListener('toggle', onToggle);
    return () => {
      document.removeEventListener('click', onDocClick);
      document.removeEventListener('keydown', onKey);
      document.documentElement.style.overflow = '';
    };
  });
</script>
