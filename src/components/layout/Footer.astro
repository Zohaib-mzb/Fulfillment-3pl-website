---
import Logo from '@/components/Logo.astro';
import { SITE, FOOTER_NAV, phoneHref } from '@/config/site';
import { CITIES } from '@/data/cities';
const tel = phoneHref();
---
<footer class="on-dark bg-navy text-white" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Site footer</h2>
  <div class="container-site py-16">
    <div class="grid gap-12 lg:grid-cols-[1.2fr_2fr]">
      <div>
        <a href="/" class="inline-block rounded-lg no-underline" aria-label="Kinematics home"><Logo variant="reversed" size={40} /></a>
        <p class="mt-5 font-heading text-2xl font-semibold">{SITE.tagline}</p>
        <p class="mt-3 max-w-sm text-[#C9D2DC]">3PL fulfillment and final mile delivery for growing brands, from one Toronto team.</p>
        <address class="mt-6 grid gap-1.5 not-italic text-[#C9D2DC]">
          <span class="font-semibold text-white">{SITE.legalName}</span>
          <span>{SITE.address.streetAddress && <>{SITE.address.streetAddress}, </>}{SITE.address.locality}, {SITE.address.regionName}{SITE.address.postalCode && <> {SITE.address.postalCode}</>}</span>
          <a href={`mailto:${SITE.email}`} class="text-white underline decoration-teal decoration-2">{SITE.email}</a>
          {tel && <a href={tel} class="text-white underline decoration-teal decoration-2">{SITE.phone}</a>}
        </address>
        <div class="mt-5 text-[#C9D2DC]">
          <p class="font-semibold text-white">Hours ({SITE.hoursNote})</p>
          <ul class="mt-1.5 grid gap-1">
            {SITE.hours.map((h) => <li>{h.label}: {h.time === 'Closed' ? 'closed' : h.time}</li>)}
          </ul>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
        {FOOTER_NAV.map((col) => (
          <nav aria-label={`Footer: ${col.label}`}>
            <h3 class="font-heading text-sm font-semibold uppercase tracking-[0.14em] text-teal">{col.label}</h3>
            <ul class="mt-4 grid gap-2.5">
              {col.items.map((i) => <li><a href={i.href} class="text-[#E3E8ED] no-underline hover:text-white hover:underline">{i.label}</a></li>)}
            </ul>
          </nav>
        ))}
      </div>
    </div>

    <div class="mt-14 border-t border-white/15 pt-8">
      <h3 class="font-heading text-sm font-semibold uppercase tracking-[0.14em] text-teal">Service areas</h3>
      <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
        {CITIES.map((c) => <li><a href={`/service-areas/${c.slug}`} class="text-[#E3E8ED] no-underline hover:text-white hover:underline">{c.name}</a></li>)}
        <li><a href="/service-areas" class="text-[#E3E8ED] no-underline hover:text-white hover:underline">All GTA service areas</a></li>
      </ul>
    </div>

    <div class="mt-10 flex flex-col gap-4 border-t border-white/15 pt-8 text-sm text-[#C9D2DC] md:flex-row md:items-center md:justify-between">
      <p class="flex items-center gap-2">
        <span class="route-line-h inline-block h-3 w-14" aria-hidden="true"></span>
        <span class="inline-block size-2.5 rounded-full bg-orange" aria-hidden="true"></span>
        EV first delivery across the GTA
      </p>
      {SITE.social.some((x) => x.href) && (
        <ul class="flex gap-5" aria-label="Social media">
          {SITE.social.filter((x) => x.href).map((x) => (
            <li>
              <a href={x.href} class="inline-flex items-center gap-2 text-white no-underline hover:underline" rel="me noopener" target="_blank">
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.6c0-1.34-.02-3.06-1.86-3.06-1.87 0-2.15 1.46-2.15 2.96V21H9z"/></svg>
                {x.label}<span class="sr-only"> (opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      )}
      <p>© {new Date().getFullYear()} {SITE.legalName}</p>
    </div>
  </div>
</footer>
