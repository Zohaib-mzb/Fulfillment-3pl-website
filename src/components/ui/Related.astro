---
/** Internal-linking block: related services, industries, cities and blog posts. */
import { getCollection } from 'astro:content';
import { SERVICES } from '@/data/services';
import { INDUSTRIES } from '@/data/industries';
import { CITIES } from '@/data/cities';
import Icon from './Icon.astro';

interface Props {
  services?: string[];
  industries?: string[];
  cities?: string[] | 'all';
  posts?: string[];
  title?: string;
}
const { services = [], industries = [], cities = [], posts = [], title = 'Related' } = Astro.props;
const allPosts = posts.length ? await getCollection('blog', (p) => !p.data.draft) : [];
const groups = [
  { label: 'Services', items: SERVICES.filter((s) => services.includes(s.slug)).map((s) => ({ href: s.href, label: s.name })) },
  { label: 'Industries', items: INDUSTRIES.filter((i) => industries.includes(i.slug)).map((i) => ({ href: `/industries/${i.slug}`, label: i.name })) },
  {
    label: 'Service areas',
    items: CITIES.filter((c) => cities === 'all' || cities.includes(c.slug)).map((c) => ({ href: `/service-areas/${c.slug}`, label: `Delivery in ${c.name}` })),
  },
  { label: 'From the blog', items: posts.map((slug) => allPosts.find((p) => p.id === slug)).filter(Boolean).map((p) => ({ href: `/blog/${p!.id}`, label: p!.data.title })) },
].filter((g) => g.items.length);
---
{groups.length > 0 && (
  <section class="bg-white py-16" aria-labelledby="related-title">
    <div class="container-site">
      <h2 id="related-title" class="text-2xl sm:text-3xl">{title}</h2>
      <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {groups.map((g) => (
          <nav aria-label={g.label}>
            <h3 class="font-heading text-sm font-semibold uppercase tracking-[0.14em] text-teal-ink">{g.label}</h3>
            <ul class="mt-3 grid gap-2">
              {g.items.map((i) => (
                <li><a href={i.href} class="group inline-flex items-start gap-2 font-medium text-navy no-underline hover:underline"><Icon name="arrow" size={18} class="mt-1 shrink-0 text-teal-ink" />{i.label}</a></li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
    </div>
  </section>
)}
