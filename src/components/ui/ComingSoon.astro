---
interface Props { label?: string; class?: string }
const { label = 'Coming soon', class: cls = '' } = Astro.props;
---
<span class:list={['inline-flex items-center gap-1.5 rounded-full border border-teal/40 bg-teal-50 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-teal-ink', cls]}>
  <span class="size-1.5 rounded-full bg-teal" aria-hidden="true"></span>{label}
</span>
