---
/**
 * Clearly labelled slot for a real photo. Every use must have a matching
 * entry (by `shot` id) in PHOTO_SHOTLIST.md. Swap for <Image> when the photo exists.
 */
interface Props { shot: string; label: string; ratio?: string; class?: string }
const { shot, label, ratio = '4 / 3', class: cls = '' } = Astro.props;
---
<figure class:list={['relative grid place-items-center overflow-hidden rounded-card border-2 border-dashed border-slate-line bg-cloud p-6 text-center', cls]} style={`aspect-ratio:${ratio}`} data-photo-placeholder={shot}>
  <div>
    <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true" class="mx-auto text-slate"><rect x="4" y="9" width="32" height="24" rx="4" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="20" cy="21" r="6" fill="none" stroke="currentColor" stroke-width="2" /><rect x="14" y="5" width="12" height="5" rx="2" fill="currentColor" /></svg>
    <figcaption class="mt-3 text-sm text-slate"><span class="font-semibold text-navy">Photo coming soon</span><br />{label}<br /><span class="text-xs">Shot {shot}</span></figcaption>
  </div>
</figure>
