---
import type { QA } from '@/lib/schema';
import { marked } from '@/lib/inline-md';
interface Props { items: QA[]; title?: string; headingLevel?: 2 | 3; id?: string; intro?: string }
const { items, title = 'Frequently asked questions', headingLevel = 2, id = 'faq', intro } = Astro.props;
const H = `h${headingLevel}` as 'h2' | 'h3';
---
<section aria-labelledby={`${id}-title`} class="faq">
  <H id={`${id}-title`} class="text-3xl sm:text-4xl">{title}</H>
  {intro && <p class="lede mt-3 max-w-2xl">{intro}</p>}
  <div class="mt-8 divide-y divide-slate-line border-y border-slate-line">
    {items.map((item) => (
      <details class="group py-1">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-4 font-heading text-lg font-semibold text-navy [&::-webkit-details-marker]:hidden">
          <span>{item.q}</span>
          <span aria-hidden="true" class="mt-1 grid size-7 shrink-0 place-items-center rounded-full border border-slate-line transition-transform group-open:rotate-45">
            <svg width="12" height="12" viewBox="0 0 12 12"><path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
          </span>
        </summary>
        <div class="pb-5 pr-10 text-navy/85" set:html={marked(item.a)} />
      </details>
    ))}
  </div>
</section>
