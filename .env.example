# ─── Server (Hostinger Node.js web app) ─────────────────────────
# Hostinger sets PORT automatically. The server binds to all interfaces by default;
# set HOST only to override that.
# PORT=3000
# HOST=0.0.0.0

# ─── Forms / email ──────────────────────────────────────────────
# Provider: resend | postmark | webhook | console (console = log only, for local dev)
EMAIL_PROVIDER=resend
# Where form submissions are sent
EMAIL_TO=info@kinematicstech.ca
# Recipient for form email (falls back to EMAIL_TO). Also used, at build time, for the "send from your email" fallback links.
FORM_TO_EMAIL=info@kinematicstech.ca
# Sender — the domain must be verified with your provider (e.g. in Resend → Domains)
EMAIL_FROM="Kinematics Website <forms@kinematicstech.ca>"

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=
# Postmark (alternative)
POSTMARK_SERVER_TOKEN=
# Webhook (alternative): receives JSON { subject, replyTo, text, meta }
FORM_WEBHOOK_URL=
FORM_WEBHOOK_SECRET=

# ─── Rate limiting ──────────────────────────────────────────────
# Submissions allowed per IP per window, per form
FORM_RATE_LIMIT=5
FORM_RATE_WINDOW_SEC=600
# Optional shared limiter (useful if the app ever runs more than one process) (https://upstash.com — Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Site ───────────────────────────────────────────────────────
# Used for the form origin check
PUBLIC_SITE_URL=https://kinematicstech.ca

# ─── Tracking ───────────────────────────────────────────────────
# When set, /track submits ?tracking=<number> to this URL (GET) and the "launching soon" state is removed.
PUBLIC_TRACKING_URL=

# ─── Analytics (loads only after cookie consent) ────────────────
# plausible | ga4 | none
PUBLIC_ANALYTICS_PROVIDER=none
PUBLIC_PLAUSIBLE_DOMAIN=kinematicstech.ca
PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.tagged-events.js
PUBLIC_GA4_ID=
